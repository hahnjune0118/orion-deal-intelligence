        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "source_span_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{2,63}$"
          },
          "minItems": 0,
