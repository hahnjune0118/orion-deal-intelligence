{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orion:contracts:1.0.0",
  "title": "Orion Deal Intelligence 2.0 version 1.0.0",
  "description": "Structural contracts. Cross-record, grounding, authorization and transition rules are additional mandatory application validators.",
  "oneOf": [
    {
      "$ref": "#/$defs/DealState"
    },
    {
      "$ref": "#/$defs/StagedEvidenceUpdate"
    },
    {
      "$ref": "#/$defs/ExpectedTransition"
    }
  ],
  "$defs": {
    "PdfLocator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "pdf"
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "block_index": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "kind",
        "page",
        "block_index"
      ]
    },
    "PptxLocator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "pptx"
        },
        "slide": {
          "type": "integer",
          "minimum": 1
        },
        "shape_id": {
          "type": "integer",
          "minimum": 0
        },
        "paragraph_index": {
          "type": "integer",
          "minimum": 0
        },
        "table_cell": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "row": {
                  "type": "integer",
                  "minimum": 0
                },
                "column": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "row",
                "column"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "slide",
        "shape_id",
        "paragraph_index",
        "table_cell"
      ]
    },
    "DocxParagraphLocator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "docx_paragraph"
        },
        "part_uri": {
          "const": "word/document.xml"
        },
        "block_index": {
          "type": "integer",
          "minimum": 0
        },
        "paragraph_index": {
          "type": "integer",
          "minimum": 0
        },
        "heading_path": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "kind",
        "part_uri",
        "block_index",
        "paragraph_index",
        "heading_path"
      ]
    },
    "DocxTableLocator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "docx_table_cell"
        },
        "part_uri": {
          "const": "word/document.xml"
        },
        "table_index": {
          "type": "integer",
          "minimum": 0
        },
        "row": {
          "type": "integer",
          "minimum": 0
        },
        "column": {
          "type": "integer",
          "minimum": 0
        },
        "paragraph_index": {
          "type": "integer",
          "minimum": 0
        },
        "heading_path": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "kind",
        "part_uri",
        "table_index",
        "row",
        "column",
        "paragraph_index",
        "heading_path"
      ]
    },
    "Locator": {
      "oneOf": [
        {
          "$ref": "#/$defs/PdfLocator"
        },
        {
          "$ref": "#/$defs/PptxLocator"
        },
        {
          "$ref": "#/$defs/DocxParagraphLocator"
        },
        {
          "$ref": "#/$defs/DocxTableLocator"
        }
      ]
    },
    "Deal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{2,63}$"
        },
        "entity_version": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "business_model": {
          "type": "string",
          "minLength": 1
        },
        "currency": {
          "const": "USD"
        },
        "synthetic": {
          "const": true
        },
        "as_of": {
          "type": "string",
          "format": "date"
        },
        "thesis_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{2,63}$"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "entity_version",
        "name",
        "business_model",
        "currency",
        "synthetic",
        "as_of",
        "thesis_ids"
      ]
    },
    "Document": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{2,63}$"
        },
        "entity_version": {
          "type": "integer",
          "minimum": 1
        },
        "deal_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{2,63}$"
        },
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "type": "string",
          "enum": [
            "pdf",
            "docx",
            "pptx"
          ]
        },
        "document_version": {
          "type": "integer",
          "minimum": 1
        },
        "asset_status": {
          "type": "string",
          "enum": [
            "fixture_text_only",
            "file_verified"
          ]
        },
        "file_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "parse_status": {
          "type": "string",
          "enum": [
            "pending",
            "parsed",
            "needs_ocr",
            "needs_manual_review",
            "failed"
          ]
        },
        "parser_version": {
          "type": "string",
          "minLength": 1
        },
        "source_origin": {
          "type": "string",
          "enum": [
            "company",
            "counterparty",
            "independent",
            "analyst"
          ]
        },
        "origin_key": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      },
      "required": [
        "id",
        "entity_version",
        "deal_id",
        "filename",
        "format",
        "document_version",
        "asset_status",
        "file_sha256",
        "parse_status",
        "parser_version",
        "source_origin",
        "origin_key",
        "created_at"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "asset_status": {
                "const": "file_verified"
              }
            }
          },
          "then": {
            "properties": {
              "file_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      ]
    },
    "SourceSpan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{2,63}$"
        },
        "entity_version": {
          "type": "integer",
          "minimum": 1
        },
        "deal_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{2,63}$"
        },
        "document_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{2,63}$"
        },
        "document_version": {
          "type": "integer",
          "minimum": 1
        },
        "locator": {
          "$ref": "#/$defs/Locator"
        },
        "normalized_text": {
          "type": "string",
          "minLength": 1
        },
        "text_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        },
        "locator_status": {
          "type": "string",
          "enum": [
            "validated",
            "unverified",
            "invalid"
          ]
        },
        "extraction_method": {
          "type": "string",
          "enum": [
            "parsed",
            "ocr_reviewed",
            "manual_checked",
            "fixture"
          ]
        }
      },
      "required": [
        "id",
        "entity_version",
        "deal_id",
        "document_id",
        "document_version",
        "locator",
        "normalized_text",
        "text_sha256",
        "quote",
        "start",
        "end",
        "locator_status",
        "extraction_method"
      ]
    },
    "Thesis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{2,63}$"
        },
        "entity_version": {
          "type": "integer",
          "minimum": 1
        },
        "deal_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{2,63}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "counter_thesis": {
          "type": "string",
          "minLength": 1
        },
        "claim_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{2,63}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "review_status": {
          "type": "string",
          "enum": [
            "draft",
            "approved",
            "rejected"
          ]
        }
      },
      "required": [
        "id",
        "entity_version",
        "deal_id",
        "title",
        "counter_thesis",
        "claim_ids",
        "review_status"
      ]
    },
    "Claim": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{2,63}$"
        },
        "entity_version": {
          "type": "integer",
          "minimum": 1
        },
        "deal_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{2,63}$"
        },
        "thesis_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{2,63}$"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "subject_key": {
          "type": "string",
          "minLength": 1
        },
        "period_start": {
          "type": "string",
          "format": "date"
        },
        "period_end": {
          "type": "string",
          "format": "date"
        },
        "claim_kind": {
          "type": "string",
          "enum": [
            "company_reported",
            "analyst_assumption",
            "binary_hypothesis"
          ]
        },
        "source_span_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{2,63}$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "required_criterion_keys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "support_status": {
          "type": "string",
          "enum": [
            "missing",
            "partial",
            "supported",
            "contradicted"
          ]
        },
        "truth_status": {
          "type": "string",
          "enum": [
            "not_checked",
            "document_only",
            "independently_verified",
            "disputed"
          ]
        },
        "review_status": {
          "type": "string",
          "enum": [
            "draft",
            "approved",
            "rejected"
          ]
        }
      },
      "required": [
        "id",
        "entity_version",
        "deal_id",
        "thesis_id",
        "statement",
        "subject_key",
        "period_start",
        "period_end",
        "claim_kind",
        "source_span_ids",
        "required_criterion_keys",
        "support_status",
        "truth_status",
        "review_status"
      ]
    },
    "Evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{2,63}$"
        },
        "entity_version": {
          "type": "integer",
          "minimum": 1
        },
        "deal_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{2,63}$"
        },
        "claim_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{2,63}$"
        },
        "source_span_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{2,63}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "stance": {
          "type": "string",
          "enum": [
            "supports",
            "refutes",
            "context"
          ]
        },
        "criterion_keys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "provenance": {
          "type": "string",
          "enum": [
            "company_reported",
            "counterparty_reported",
            "independent_source",
            "analyst_note"
          ]
        },
        "source_reliability": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 5
            },
            {
              "type": "null"
            }
          ]
        },
        "reliability_rationale": {
          "type": "string",
          "minLength": 1
        },
        "verification_level": {
          "type": "string",
          "enum": [
            "document_only",
            "independent_check"
          ]
        },
        "independent_check_reference": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "origin_key": {
          "type": "string",
          "minLength": 1
        },
        "review_status": {
          "type": "string",
          "enum": [
            "draft",
            "approved",
            "rejected"
          ]
        },
        "lifecycle": {
          "type": "string",
          "enum": [
            "active",
            "superseded"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      },
      "required": [
        "id",
        "entity_version",
        "deal_id",
        "claim_id",
        "source_span_ids",
        "stance",
        "criterion_keys",
        "provenance",
        "source_reliability",
        "reliability_rationale",
        "verification_level",
        "independent_check_reference",
        "origin_key",
        "review_status",
        "lifecycle",
        "created_at"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "verification_level": {
                "const": "independent_check"
              }
            }
          },
          "then": {
            "properties": {
              "independent_check_reference": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "EvidenceRelation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{2,63}$"
        },
        "entity_version": {
