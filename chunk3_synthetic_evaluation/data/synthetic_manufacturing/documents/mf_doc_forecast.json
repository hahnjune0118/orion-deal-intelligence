        "part_uri": "word/document.xml"
      },
      "locator_status": "validated",
      "normalized_text": "SYNTHETIC DATA. Management plan version 1, dated 2026-11-03. Forecasts are assumptions and have no independent assurance. No unprovided FY2026 actual result is assumed.",
      "quote": "SYNTHETIC DATA. Management plan version 1, dated 2026-11-03. Forecasts are assumptions and have no independent assurance. No unprovided FY2026 actual result is assumed.",
      "start": 0,
      "text_sha256": "75ae512513f943ed13671511c65c882a4205995fed283e1e3890441ba75fb551"
    },
    {
      "deal_id": "deal_mf",
      "document_id": "mf_doc_forecast",
      "document_version": 1,
      "end": 274,
      "entity_version": 1,
      "extraction_method": "parsed",
      "id": "span_mf_doc_forecast_b8b908136ba97ae31d92",
      "locator": {
        "block_index": 4,
        "heading_path": [],
        "kind": "docx_paragraph",
        "paragraph_index": 0,
        "part_uri": "word/document.xml"
      },
      "locator_status": "validated",
      "normalized_text": "FY2027 revenue is forecast as 120,000 standardized production-slot equivalents at a blended USD 100 revenue per equivalent, totaling USD 12,000,000. Cost of sales USD 7,560,000 and operating expense excluding depreciation USD 2,740,000 produce forecast EBITDA USD 1,700,000.",
      "quote": "FY2027 revenue is forecast as 120,000 standardized production-slot equivalents at a blended USD 100 revenue per equivalent, totaling USD 12,000,000. Cost of sales USD 7,560,000 and operating expense excluding depreciation USD 2,740,000 produce forecast EBITDA USD 1,700,000.",
      "start": 0,
      "text_sha256": "13f630dbe4fc8152497d939d4c317755f353a680b7fd013e60de5f67cca163b6"
    },
    {
      "deal_id": "deal_mf",
      "document_id": "mf_doc_forecast",
      "document_version": 1,
      "end": 280,
      "entity_version": 1,
      "extraction_method": "parsed",
      "id": "span_mf_doc_forecast_191a515cea89c504585a",
      "locator": {
        "block_index": 5,
        "heading_path": [],
        "kind": "docx_paragraph",
        "paragraph_index": 0,
        "part_uri": "word/document.xml"
      },
      "locator_status": "validated",
      "normalized_text": "The plan assumes the additional press will be available for the whole year. With current practical capacity of 100,000 equivalents and the same blended revenue rate, supported capacity would produce USD 10,000,000. No funded installation schedule supports the additional capacity.",
      "quote": "The plan assumes the additional press will be available for the whole year. With current practical capacity of 100,000 equivalents and the same blended revenue rate, supported capacity would produce USD 10,000,000. No funded installation schedule supports the additional capacity.",
      "start": 0,
      "text_sha256": "a7de3812a424f1d24f961355a7121e7d03af611609a9e5420cfe3d342c87afd1"
    },
    {
      "deal_id": "deal_mf",
      "document_id": "mf_doc_forecast",
      "document_version": 1,
      "end": 289,
      "entity_version": 1,
      "extraction_method": "parsed",
      "id": "span_mf_doc_forecast_06cc025652266517e8ba",
      "locator": {
        "block_index": 6,
        "heading_path": [],
        "kind": "docx_paragraph",
        "paragraph_index": 0,
        "part_uri": "word/document.xml"
      },
      "locator_status": "validated",
      "normalized_text": "The FY2027 plan reduces closing inventory to USD 1,200,000 while cost of sales rises to USD 7,560,000. The target implies 57.9365 closing-inventory days, compared with 136.875 days in FY2025. No signed inventory clearance program or documented lead-time improvement supports the reduction.",
      "quote": "The FY2027 plan reduces closing inventory to USD 1,200,000 while cost of sales rises to USD 7,560,000. The target implies 57.9365 closing-inventory days, compared with 136.875 days in FY2025. No signed inventory clearance program or documented lead-time improvement supports the reduction.",
      "start": 0,
      "text_sha256": "d51359a08fbe9c28fd839d076b81e01e739ac7d415947fe0192b386245162c26"
    },
    {
      "deal_id": "deal_mf",
      "document_id": "mf_doc_forecast",
      "document_version": 1,
      "end": 281,
      "entity_version": 1,
      "extraction_method": "parsed",
      "id": "span_mf_doc_forecast_a4cca3fc86d289434ceb",
      "locator": {
        "block_index": 7,
        "heading_path": [],
        "kind": "docx_paragraph",
        "paragraph_index": 0,
        "part_uri": "word/document.xml"
      },
      "locator_status": "validated",
      "normalized_text": "Planned operating NWC is USD 1,500,000: receivables USD 1,800,000 plus inventory USD 1,200,000 plus prepaids USD 100,000 less trade payables USD 1,200,000 and accrued operating costs USD 400,000. Relative to FY2025, the plan assumes USD 1,100,000 cash release from working capital.",
      "quote": "Planned operating NWC is USD 1,500,000: receivables USD 1,800,000 plus inventory USD 1,200,000 plus prepaids USD 100,000 less trade payables USD 1,200,000 and accrued operating costs USD 400,000. Relative to FY2025, the plan assumes USD 1,100,000 cash release from working capital.",
      "start": 0,
      "text_sha256": "cb866f08fe5a9b8293f38c5c709dc0dab1baed6295932c3e5864312c0892d881"
    },
    {
      "deal_id": "deal_mf",
      "document_id": "mf_doc_forecast",
      "document_version": 1,
      "end": 227,
      "entity_version": 1,
      "extraction_method": "parsed",
