        "kind": "docx_paragraph",
        "paragraph_index": 0,
        "part_uri": "word/document.xml"
      },
      "locator_status": "validated",
      "normalized_text": "Management repeats that EBITDA growth proves cash generation, that all CAPEX is expansion and that inventory will halve. These answers repeat the management financial and plant schedules; they are not independent confirmations.",
      "quote": "Management repeats that EBITDA growth proves cash generation, that all CAPEX is expansion and that inventory will halve. These answers repeat the management financial and plant schedules; they are not independent confirmations.",
      "start": 0,
      "text_sha256": "3a276a3d2213bc343c2f3f409fa5afa0fdd726c5753afefcffaa18b3d1070adb"
