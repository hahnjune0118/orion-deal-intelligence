 "entity_version": 2, "deal_id": "deal_mf", "thesis_id": "mf_thesis", "statement": "FY2025 inventory and operating working capital are supportable: inventory count variance is at most 1%, no inventory impairment above USD 100,000 is required, and the planned FY2027 USD 1,100,000 NWC release is backed by collection and inventory actions.", "subject_key": "mf_h1", "period_start": "2025-01-01", "period_end": "2027-12-31", "claim_kind": "binary_hypothesis", "source_span_ids": [], "required_criterion_keys": ["inventory_count", "inventory_valuation", "working_capital"], "support_status": "contradicted", "truth_status": "disputed", "review_status": "approved"}, {"id": "mf_claim_h2", "entity_version": 2, "deal_id": "deal_mf", "thesis_id": "mf_thesis", "statement": "Recurring FY2025 EBITDA is at least USD 1,100,000 after substantiated normalization and cash generated from operations after sustainable maintenance CAPEX is positive.", "subject_key": "mf_h2", "period_start": "2025-01-01", "period_end": "2027-12-31", "claim_kind": "binary_hypothesis", "source_span_ids": [], "required_criterion_keys": ["ebitda", "maintenance_capex", "cash_conversion"], "support_status": "contradicted", "truth_status": "disputed", "review_status": "approved"}, {"id": "mf_claim_h3", "entity_version": 2, "deal_id": "deal_mf", "thesis_id": "mf_thesis", "statement": "The FY2027 USD 12,000,000 revenue forecast is supported by funded practical production capacity and binding demand, with no customer exceeding 40% of revenue and reconciled historical product sales.", "subject_key": "mf_h3", "period_start": "2025-01-01", "period_end": "2027-12-31", "claim_kind": "binary_hypothesis", "source_span_ids": [], "required_criterion_keys": ["concentration", "capacity", "sales_mix"], "support_status": "contradicted", "truth_status": "disputed", "review_status": "approved"}], "evidence": [{"id": "mf_ev_income", "entity_version": 1, "deal_id": "deal_mf", "claim_id": "mf_claim_h2", "source_span_ids": ["span_mf_doc_fi