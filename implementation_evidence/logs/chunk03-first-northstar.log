_uri": "word/document.xml", "block_index": 9, "paragraph_index": 0, "heading_path": []}, "normalized_text": "Management has not provided beneficial ownership evidence for the prospective customers. Client names alone do not establish independence.", "text_sha256": "ab343e7e6cf46a6e679374340a9e3aee01394d35b95994f1401827052a85d7d0", "quote": "Management has not provided beneficial ownership evidence for the prospective customers. Client names alone do not establish independence.", "start": 0, "end": 138, "locator_status": "validated", "extraction_method": "parsed"}, {"id": "span_nb_doc_crm_1beb28cc2e23b71f7f8c", "entity_version": 1, "deal_id": "deal_nb", "document_id": "nb_doc_crm", "document_version": 1, "locator": {"kind": "docx_table_cell", "part_uri": "word/document.xml", "table_index": 0, "row": 3, "column": 2, "paragraph_index": 0, "heading_path": []}, "normalized_text": "240000", "text_sha256": "cf636823e14b5d2d47239eb0002d97fb78283d0b35a35bf81e8fa9db2f73b9a1", "quote": "240000", "start": 0, "end": 6, "locator_status": "validated", "extraction_method": "parsed"}, {"id": "span_nb_doc_crm_21a58f9eac98ea374994", "entity_version": 1, "deal_id": "deal_nb", "document_id": "nb_doc_crm", "document_version": 1, "locator": {"kind": "docx_paragraph", "part_uri": "word/document.xml", "block_index": 8, "paragraph_index": 0, "heading_path": []}, "normalized_text": "Management says cloud and standard support are included in gross margin, but states that implementation payroll and variable inference usage require a separate allocation exercise.", "text_sha256": "855779d33449d3e388f65b10f1042ffb9966f59e0ad4773782cb6ca72b795964", "quote": "Management says cloud and standard support are included in gross margin, but states that implementation payroll and variable inference usage require a separate allocation exercise.", "start": 0, "end": 180, "locator_status": "validated", "extraction_method": "parsed"}, {"id": "span_nb_doc_crm_24243c86956f9b180338", "entity_version": 1, "deal_i