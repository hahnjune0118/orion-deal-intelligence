": 0, "heading_path": []}, "normalized_text": "Reporting period: FY2025 and FY2027 plan", "text_sha256": "3798b4d91139c8889add8f7b8248c57b573eb34d9b0fa77cef11dd6f5f9b5b1f", "quote": "Reporting period: FY2025 and FY2027 plan", "start": 0, "end": 40, "locator_status": "validated", "extraction_method": "parsed"}, {"id": "span_nb_doc_crm_9bfdd9ede06bf4570e19", "entity_version": 1, "deal_id": "deal_nb", "document_id": "nb_doc_crm", "document_version": 1, "locator": {"kind": "docx_paragraph", "part_uri": "word/document.xml", "block_index": 3, "paragraph_index": 0, "heading_path": []}, "normalized_text": "Independent expanded research scenario NB version 3.0.0. This is not a continuation of legacy Northstar NS; contract, cash and customer assumptions differ.", "text_sha256": "9d225433a95c28903c8f68929f3ef8c4737d81ce8e4b713cf3816ad4ecea3f93", "quote": "Independent expanded research scenario NB version 3.0.0. This is not a continuation of legacy Northstar NS; contract, cash and customer assumptions differ.", "start": 0, "end": 155, "locator_status": "validated", "extraction_method": "parsed"}, {"id": "span_nb_doc_crm_1b0a3738f2935bd6e144", "entity_version": 1, "deal_id": "deal_nb", "document_id": "nb_doc_crm", "document_version": 1, "locator": {"kind": "docx_paragraph", "part_uri": "word/document.xml", "block_index": 4, "paragraph_index": 0, "heading_path": []}, "normalized_text": "SYNTHETIC DATA. CRM snapshot and initial management Q&A dated 2026-11-03. Pipeline classifications are recorded separately from legal contract status.", "text_sha256": "5faec08f30c8fc6fdf0668e4ac805e527b483c9335e1743001a4252e6eff4905", "quote": "SYNTHETIC DATA. CRM snapshot and initial management Q&A dated 2026-11-03. Pipeline classifications are recorded separately from legal contract status.", "start": 0, "end": 150, "locator_status": "validated", "extraction_method": "parsed"}, {"id": "span_nb_doc_crm_b16231fe76bb964f16e8", "entity_version": 1, "deal_id": "deal_nb", "document_id": "nb_doc_crm", "document_version": 1, "locator": {"kind": "docx_paragraph", "part_uri": "word/document.xml", "block_index": 5, "paragraph_index": 0, "heading_path": []}, "normalized_text": "Quartz and Vale are existing paying customers. Aster has a completed technical proof of concept but no executed commercial contract in the supplied pack. Birch has a nonbinding letter of interest, no executed contract and no deployment.", "text_sha256": "8066cdde7dd80cb1f65a8dbbd35fda1a5cd042e25fc22444b0bc488066de4f7a", "quote": "Quartz and Vale are existing paying customers. Aster has a completed technical proof of concept but no executed commercial contract in the supplied pack. Birch has a nonbinding letter of interest, no executed contract and no deployment.", "start": 0, "end": 236, "locator_status": "validated", "extraction_method": "parsed"}, {"id": "span_nb_doc_crm_c5dc2d59afbb174857ba", "entity_version": 1, "deal_id": "deal_nb", "document_id": "nb_doc_crm", "document_version": 1, "locator": {"kind": "docx_paragraph", "part_uri": "word/document.xml", "block_index": 6, "paragraph_index": 0, "heading_path": []}, "normalized_text": "Management labels the Aster USD 240,000 and Birch USD 360,000 pipeline opportunities as committed ARR in the CIM. Under this CRM snapshot they remain unsigned opportunities and are not committed recurring contract revenue.", "text_sha256": "e21d8479a30fd7d9b80bf6ee1541030f48e8dfe6502637c97ef01e5df87b54e9", "quote": "Management labels the Aster USD 240,000 and Birch USD 360,000 pipeline opportunities as committed ARR in the CIM. Under this CRM snapshot they remain unsigned opportunities and are not committed recurring contract revenue.", "start": 0, "end": 222, "locator_status": "validated", "extraction_method": "parsed"}, {"id": "span_nb_doc_crm_8aa8aa433970af3f0236", "entity_version": 1, "deal_id": "deal_nb", "document_id": "nb_doc_crm", "document_version": 1, "locator": {"kind": "docx_paragraph", "part_uri": "word/document.xml", "block_index": 7, "paragraph_