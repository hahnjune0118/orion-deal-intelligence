rion-native-1.0.0", "source_origin": "company", "origin_key": "nb_doc_crm", "created_at": "2026-11-03T00:00:00Z"}], "source_spans": [{"id": "span_nb_doc_cim_95be9cc3097b8991be39", "entity_version": 1, "deal_id": "deal_nb", "document_id": "nb_doc_cim", "document_version": 1, "locator": {"kind": "docx_paragraph", "part_uri": "word/document.xml", "block_index": 0, "paragraph_index": 0, "heading_path": []}, "normalized_text": "Northstar Analytics Investment Overview", "text_sha256": "05a02ad58f6705e3552da9c2b9d6efab428188dddb18272bff9b6c86f6e19144", "quote": "Northstar Analytics Investment Overview", "start": 0, "end": 39, "locator_status": "validated", "extraction_method": "parsed"}, {"id": "span_nb_doc_cim_09e831ba10bb0d820827", "entity_version": 1, "deal_id": "deal_nb", "document_id": "nb_doc_cim", "document_version": 1, "locator": {"kind": "docx_paragraph", "part_uri": "word/document.xml", "block_index": 1, "paragraph_index": 0, "heading_path": []}, "normalized_text": "SYNTHETIC | nb_doc_cim | 2026-11-03 | Version 1", "text_sha256": "b067e9caa14f1eeac7541df432d4df7a6b415e04f8ee161ced92968f24f2184c", "quote": "SYNTHETIC | nb_doc_cim | 2026-11-03 | Version 1", "start": 0, "end": 47, "locator_status": "validated", "extraction_method": "parsed"}, {"id": "span_nb_doc_cim_83030ce229421813a642", "entity_version": 1, "deal_id": "deal_nb", "document_id": "nb_doc_cim", "document_version": 1, "locator": {"kind": "docx_paragraph", "part_uri": "word/document.xml", "block_index": 2, "paragraph_index": 0, "heading_path": []}, "normalized_text": "Reporting period: FY2025 and FY2027 plan", "text_sha256": "3798b4d91139c8889add8f7b8248c57b573eb34d9b0fa77cef11dd6f5f9b5b1f", "quote": "Reporting period: FY2025 and FY2027 plan", "start": 0, "end": 40, "locator_status": "validated", "extraction_method": "parsed"}, {"id": "span_nb_doc_cim_1222723f4a487ac339f2", "entity_version": 1, "deal_id": "deal_nb", "document_id": "nb_doc_cim", "document_version": 1, "locator": {"kind": "docx_paragraph", "part_uri": "word/document.xml", "block_index": 3, "paragraph_index": 0, "heading_path": []}, "normalized_text": "Independent expanded research scenario NB version 3.0.0. This is not a continuation of legacy Northstar NS; contract, cash and customer assumptions differ.", "text_sha256": "9d225433a95c28903c8f68929f3ef8c4737d81ce8e4b713cf3816ad4ecea3f93", "quote": "Independent expanded research scenario NB version 3.0.0. This is not a continuation of legacy Northstar NS; contract, cash and customer assumptions differ.", "start": 0, "end": 155, "locator_status": "validated", "extraction_method": "parsed"}, {"id": "span_nb_doc_cim_8ffc1ee35e5c32fb6b43", "entity_version": 1, "deal_id": "deal_nb", "document_id": "nb_doc_cim", "document_version": 1, "locator": {"kind": "docx_paragraph", "part_uri": "word/document.xml", "block_index": 4, "paragraph_index": 0, "heading_path": []}, "normalized_text": "SYNTHETIC DATA. Fictional CIM for academic preliminary investment screening. All names, customers, amounts and documents are invented. This is management reporting, not an independently verified investment conclusion.", "text_sha256": "857dcae6564bf6b59876454035da5e3df2a4457ee1f25e28ad5a06cfa3a9bf3a", "quote": "SYNTHETIC DATA. Fictional CIM for academic preliminary investment screening. All names, customers, amounts and documents are invented. This is management reporting, not an independently verified investment conclusion.", "start": 0, "end": 217, "locator_status": "validated", "extraction_method": "parsed"}, {"id": "span_nb_doc_cim_245c0cf8f3c01eefeb56", "entity_version": 1, "deal_id": "deal_nb", "document_id": "nb_doc_cim", "document_version": 1, "locator": {"kind": "docx_paragraph", "part_uri": "word/document.xml", "block_index": 5, "paragraph_index": 0, "heading_path": []}, "normalized_text": "Management reports four enterprise customers and committed annual recurring revenue of USD 1,800,000: Quartz USD 720,000, Vale USD 480,000, Aster USD 240,000 and Birch USD 360,000.", "text_sha256": "a40e26e24c39310271d37087f4ca35ec6f34486fd1d700286cd1b9ff1af7e3db", "quote": "Management reports four enterprise customers and committed annual recurring revenue of USD 1,800,000: Quartz USD 720,000, Vale USD 480,000, Aster USD 240,000 and Birch USD 360,000.", "start": 0, "end": 180, "locator_status": "validated", "extraction_method": "parsed"}, {"id": "span_nb_doc_cim_af4edbeaec54b557691b", "entity_version": 1, "deal_id": "deal_nb", "document_id": "nb_doc_cim", "document_version": 1, "locator": {"kind": "docx_paragraph", "part_uri": "word/document.xml", "block_index": 6, "paragraph_index": 0, "heading_path": []}, "normalized_text": "FY2025 revenue was USD 1,200,000 and reported gross profit was USD 840,000, a 70% gross margin. The presentation includes only cloud hosting and routine support within cost of revenue.", "text_sha256": "8b45edf58eb760b11bf488d03033d4b49549286e015fdcb4dc12c0ae5fa33dd5", "quote": "FY2025 revenue was USD 1,200,000 and reported gross profit was USD 840,000, a 70% gross margin. The presentation includes only cloud hosting and routine support within cost of revenue.", "start": 0, "end": 184, "locator_status": "validated", "extraction_method": "parsed"}, {"id": "span_nb_doc_cim_629a97ee93af25505e17", "entity_version": 1, "deal_id": "deal_nb", "document_id": "nb_doc_cim", "document_version": 1, "locator": {"kind": "docx_paragraph", "part_uri": "word/document.xml", "block_index": 7, "paragraph_index": 0, "heading_path": []}, "normalized_text": "Management estimates Aster annual subscription revenue of USD 240,000 and annual delivery costs of USD 96,000, giving positive contribution of USD 144,000. Implementation effort and incremental inference usage have not been costed.", "text_sha256": "4c06a660098198dc9c7c7b7ce9a0baefcce5a2f807b05b4c5b3e80c8ef8b5581", "quote": "Management estimates Aster annual subscription revenue of USD 240,000 and annual delivery costs of USD 96,000, giving positive contribution of USD 144,000. Implementation effort and incremental inference usage have not been costed.", "start": 0, "end": 231, "locator_status": "validated", "extraction_method": "parsed"}, {"id": "span_nb_doc_cim_e614ade6231ab676f2fc", "entity_version": 1, "deal_id": "deal_nb", "document_id": "nb_doc_cim", "document_version": 1, "locator": {"kind": "docx_paragraph", "part_uri": "word/document.xml", "block_index": 8, "paragraph_index": 0, "heading_path": []}, "normalized_text": "Quartz and Vale renewed their support subscriptions during FY2025. The delivery team retained the same four senior engineers throughout the year. Product use remains concentrated in document analytics.", "text_sha256": "c23250ea9de2115cce7aebb11d410664776e76a951ef4252ea49e45f47ccf7ec", "quote": "Quartz and Vale renewed their support subscriptions during FY2025. The delivery team retained the same four senior engineers throughout the year. Product use remains concentrated in document analytics.", "start": 0, "end": 201, "locator_status": "validated", "extraction_method": "parsed"}, {"id": "span_nb_doc_cim_d288ec2dd44035785cdb", "entity_version": 1, "deal_id": "deal_nb", "document_id": "nb_doc_cim", "document_version": 1, "locator": {"kind": "docx_paragraph", "part_uri": "word/document.xml", "block_index": 9, "paragraph_index": 0, "heading_path": []}, "normalized_text": "No customer ownership certificates, source-level inference logs or reconciled customer contribution schedules are attached. Management expects two new paying enterprise deployments by October 2027.", "text_sha256": "d2874eba60332c12883d8a6c158731633b518ec5c26da387633f7f735918da3e", "quote": "No customer ownership certificates, source-level inference logs or reconciled customer contribution schedules are attached. Management expects two new paying enterprise deployments by October 2027.", "start": 0, "end": 197, "locator_status": "validated", "extraction_method": "parsed"}, {"id": "span_nb_doc_financial_4e956764fb7263d215bc", "entity_version": 1, "deal_id": "deal_nb", "document_id": "nb_doc_financial", "document_version": 1, "locator": {"kind": "docx_paragraph", "part_uri": "word/document.xml", "block_index": 0, "paragraph_index": 0, "heading_path": []}, "normalized_text": "Northstar Historical Financial Performance", "text_sha256": "d75482045bdcb52fff465f310268511cb53876b6b1a1c4b92ddfc39c86704fc9", "quote": "Northstar Historical Financial Performance", "start": 0, "end": 42, "locator_status": "validated", "extraction_method": "parsed"}, {"id": "span_nb_doc_financial_da925f02482001412a39", "entity_version": 1, "deal_id": "deal_nb", "document_id": "nb_doc_financial", "document_version": 1, "locator": {"kind": "docx_paragraph", "part_uri": "word/document.xml", "block_index": 1, "paragraph_index": 0, "heading_path": []}, "normalized_text": "SYNTHETIC | nb_doc_financial | 2026-11-03 | Version 1", "text_sha256": "07595d8daf373477f0e27766894d61dcb30a45a842fbd22d3e51accf3d333adc", "quote": "SYNTHETIC | nb_doc_financial | 2026-11-03 | Version 1", "start": 0, "end": 53, "locator_status": "validated", "extraction_method": "parsed"}, {"id": "span_nb_doc_financial_b80b4631a2ee2afff0b8", "entity_version": 1, "deal_id": "deal_nb", "document_id": "nb_doc_financial", "document_version": 1, "locator": {"kind": "docx_paragraph", "part_uri": "word/document.xml", "block_index": 2, "paragraph_index": 0, "heading_path": []}, "normalized_text": "Reporting period: FY2024 and FY2025", "text_sha256": "3fed90e994a61c3800a6de3d320abf3f9b72ad197d7180f7126c41ad2dfe6361", "quote": "Reporting period: FY2024 and FY2025", "start": 0, "end": 35, "locator_status": "validated", "extraction_method": "parsed"}, {"id": "span_nb_doc_financial_d91ff471657b20a7ca54", "entity_version": 1, "deal_id": "deal_nb", "document_id": "nb_doc_financial", "document_version": 1, "locator": {"kind": "docx_paragraph", "part_uri": "word/document.xml", "block_index": 3, "paragraph_index": 0, "heading_path": []}, "normalized_text": "Independent expanded research scenario NB version 3.0.0. This is not a continuation of legacy Northstar NS; contract, cash and customer assumptions differ.", "text_sha256": "9d225433a95c28903c8f68929f3ef8c4737d81ce8e4b713cf3816ad4ecea3f93", "quote": "Independent expanded research scenario NB version 3.0.0. This is not a continuation of legacy Northstar NS; contract, cash and customer assumptions differ.", "start": 0, "end": 155, "locator_status": "validated", "extraction_method": "parsed"}, {"id": "span_nb_doc_financial_da9f7139c13f4e259aec", "entity_version": 1, "deal_id": "deal_nb", "document_id": "nb_doc_financial", "document_version": 1, "locator": {"kind": "docx_paragraph", "part_uri": "word/document.xml", "block_index": 4, "paragraph_index": 0, "heading_path": []}, "normalized_text": "SYNTHETIC DATA. Management financial statements in whole USD. FY2025 revenue recognition is distinct from invoicing and cash receipts. No audit or independent verification is represented.", "text_sha256": "47146d4101674af3990434a8795acb6ca8f85778b6d25ad15699fc61a902a660", "quote": "SYNTHETIC DATA. Management financial statements in whole USD. FY2025 revenue recognition is distinct from invoicing and cash receipts. No audit or independent verification is represented.", "start": 0, "end": 187, "locator_status": "validated", "extraction_method": "parsed"}, {"id": "span_nb_doc_financial_11a96adfa2f4294f13e0", "entity_version": 1, "deal_id": "deal_nb", "document_id": "nb_doc_financial", "document_version": 1, "locator": {"kind": "docx_paragraph", "part_uri": "word/document.xml", "block_index": 5, "paragraph_index": 0, "heading_path": []}, "normalized_text": "FY2025 revenue USD 1,200,000 less reported cost of revenue USD 360,000 and operating expense excluding depreciation USD 720,000 equals EBITDA USD 120,000. Depreciation USD 40,000, interest USD 20,000 and tax USD 10,000 yield net income USD 50,000.", "text_sha256": "64edd2795ce7d95cb89d50be7e921a961465be856cdca90df5cf4f5527b74969", "quote": "FY2025 revenue USD 1,200,000 less reported cost of revenue USD 360,000 and operating expense excluding depreciation USD 720,000 equals EBITDA USD 120,000. Depreciation USD 40,000, interest USD 20,000 and tax USD 10,000 yield net income USD 50,000.", "start": 0, "end": 247, "locator_status": "validated", "extraction_method": "parsed"}, {"id": "span_nb_doc_financial_626bd8d20ff54a56ca5e", "entity_version": 1, "deal_id": "deal_nb", "document_id": "nb_doc_financial", "document_version": 1, "locator": {"kind": "docx_paragraph", "part_uri": "word/document.xml", "block_index": 6, "paragraph_index": 0, "heading_path": []}, "normalized_text": "FY2025 recognized revenue is Quartz USD 720,000 plus Vale USD 480,000. Aster and Birch contributed zero recognized revenue in FY2025. Contract headline values and forecast ARR are excluded.", "text_sha256": "a8e6b863a817c5a3f5a681023638f0a405a0e578b0efc25cb5013500d57b055b", "quote": "FY2025 recognized revenue is Quartz USD 720,000 plus Vale USD 480,000. Aster and Birch contributed zero recognized revenue in FY2025. Contract headline values and forecast ARR are excluded.", "start": 0, "end": 189, "locator_status": "validated", "extraction_method": "parsed"}, {"id": "span_nb_doc_financial_04e67664538f99362046", "entity_version": 1, "deal_id": "deal_nb", "document_id": "nb_doc_financial", "document_version": 1, "locator": {"kind": "docx_paragraph", "part_uri": "word/document.xml", "block_index": 7, "paragraph_index": 0, "heading_path": []}, "normalized_text": "FY2025 cash increased by USD 150,000: cash from operations USD 110,000, CAPEX USD 80,000, new debt USD 50,000 and new equity USD 70,000. Opening cash USD 300,000 and closing cash USD 450,000.", "text_sha256": "b5e044fc5a9169066bb4c043f68e382bd34ab3f483de8cefc3cc86c084664d09", "quote": "FY2025 cash increased by USD 150,000: cash from operations USD 110,000, CAPEX USD 80,000, new debt USD 50,000 and new equity USD 70,000. Opening cash USD 300,000 and closing cash USD 450,000.", "start": 0, "end": 191, "locator_status": "validated", "extraction_method": "parsed"}, {"id": "span_nb_doc_financial_4b7ccc56a475cab97509", "entity_version": 1, "deal_id": "deal_nb", "document_id": "nb_doc_financial", "document_version": 1, "locator": {"kind": "docx_paragraph", "part_uri": "word/document.xml", "block_index": 8, "paragraph_index": 0, "heading_path": []}, "normalized_text": "Operating NWC is receivables plus prepaid operating costs less trade payables, accrued operating costs and deferred revenue: FY2024 negative USD 100,000; FY2025 negative USD 120,000. Cash and debt are excluded.", "text_sha256": "22911a84f54d0cae82248e8c026a4430727ce70e822164f933144eb9b4da834c", "quote": "Operating NWC is receivables plus prepaid operating costs less trade payables, accrued operating costs and deferred revenue: FY2024 negative USD 100,000; FY2025 negative USD 120,000. Cash and debt are excluded.", "start": 0, "end": 210, "locator_status": "validated", "extraction_method": "parsed"}, {"id": "span_nb_doc_financial_1ff6f74fda95ae0193c8", "entity_version": 1, "deal_id": "deal_nb", "document_id": "nb_doc_financial", "document_version": 1, "locator": {"kind": "docx_table_cell", "part_uri": "word/document.xml", "table_index": 0, "row": 0, "column": 0, "paragraph_index": 0, "heading_path": []}, "normalized_text": "Metric USD", "text_sha256": "fe1f784739c1793dd434c3009aaa39f9f1451becf6ce03a1265500e9c86dedaa", "quote": "Metric USD", "start": 0, "end": 10, "locator_status": "validated", "extraction_method": "parsed"}, {"id": "span_nb_doc_financial_39fc48109283f33a6174", "entity_version": 1, "deal_id": "deal_nb", "document_id": "nb_doc_financial", "document_version": 1, "locator": {"kind": "docx_table_cell", "part_uri": "word/document.xml", "table_index": 0, "row": 0, "column": 1, "paragraph_index": 0, "heading_path": []}, "normalized_text": "FY2024", "text_sha256": "ee4dccafc3a6af347b4e32fe8468657f8d0f4f4ea1e758229e751dcf6bdf4cff", "quote": "FY2024", "start": 0, "end": 6, "locator_status": "validated", "extraction_meth