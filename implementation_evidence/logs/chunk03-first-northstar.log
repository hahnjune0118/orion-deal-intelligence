xtraction_method": "parsed"}, {"id": "span_nb_doc_execution_b4c4ed1839ad72d889c0", "entity_version": 1, "deal_id": "deal_nb", "document_id": "nb_doc_execution", "document_version": 1, "locator": {"kind": "docx_paragraph", "part_uri": "word/document.xml", "block_index": 3, "paragraph_index": 0, "heading_path": []}, "normalized_text": "Independent expanded research scenario NB version 3.0.0. This is not a continuation of legacy Northstar NS; contract, cash and customer assumptions differ.", "text_sha256": "9d225433a95c28903c8f68929f3ef8c4737d81ce8e4b713cf3816ad4ecea3f93", "quote": "Independent expanded research scenario NB version 3.0.0. This is not a continuation of legacy Northstar NS; contract, cash and customer assumptions differ.", "start": 0, "end": 155, "locator_status": "validated", "extraction_method": "parsed"}, {"id": "span_nb_doc_execution_d23e913eee77e84dac0a", "entity_version": 1, "deal_id": "deal_nb", "document_id": "nb_doc_execution", "document_version": 1, "locator": {"kind": "docx_paragraph", "part_uri": "word/document.xml", "block_index": 0, "paragraph_index": 0, "heading_path": []}, "normalized_text": "Northstar Aster Deployment Billing and Collection Evidence", "text_sha256": "c6682d2a936f4609941d153982febf613c95faea36a988388018955ddedf6544", "quote": "Northstar Aster Deployment Billing and Collection Evidence", "start": 0, "end": 58, "locator_status": "validated", "extraction_method": "parsed"}, {"id": "span_nb_doc_execution_eb8e02d0beb8dac0ad88", "entity_version": 1, "deal_id": "deal_nb", "document_id": "nb_doc_execution", "document_version": 1, "locator": {"kind": "docx_paragraph", "part_uri": "word/document.xml", "block_index": 9, "paragraph_index": 0, "heading_path": []}, "normalized_text": "No new Birch contract or customer ownership confirmation is included. Aster acceptance and cash evidence must not be extrapolated to Birch.", "text_sha256": "6ad7c8120718e707c579a869af813eb560f00c0372c976377d699a8fdf08b348", "quote": "No new Birch contrac