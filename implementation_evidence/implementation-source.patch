+"""Rebuild explicit Pydantic classes from the immutable 1.0.0 contract.
+
+No third-party generator or runtime JSON Schema dependency is required.
+Conditional checks are intentionally visible Python, not a permissive generic
+validator. Review generated diffs and run contract parity tests after any use.
+"""
+from pathlib import Path
+import json
+import pprint
+
+ROOT = Path(__file__).resolve().parents[1]
+SCHEMA = json.loads((ROOT / 'spec/SCHEMAS/models.schema.json').read_text())
+HEADER = '''"""Strict structural contracts for Orion 1.0.0.
+
+Generated by scripts/generate_models.py; explicit classes are shipped at runtime.
+Cross-record integrity, authority and scoring belong to separate validators.
+Dates remain strings so validation never rewrites canonical source metadata.
+"""
+from __future__ import annotations
+
+from datetime import date, datetime
+import json
+import re
+from typing import Annotated, Any, Literal, TypeAlias
+
+from pydantic import (AfterValidator, BaseModel, BeforeValidator, ConfigDict,
+                      Field, TypeAdapter, WithJsonSchema, model_validator)
+
+CONTRACT_VERSION = "1.0.0"
+SCORING_VERSION = "1.0.0"
+
+
+def _date(value: str) -> str:
+    if not re.fullmatch(r"[0-9]{4}-[0-9]{2}-[0-9]{2}", value):
+        raise ValueError("date must use YYYY-MM-DD")
+    date.fromisoformat(value)
+    return value
+
+
+def _utc_timestamp(value: str) -> str:
+    if not re.fullmatch(r"[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z", value):
+        raise ValueError("timestamp must be an ISO-8601 UTC string ending in Z")
+    datetime.fromisoformat(value)
+    return value
+
+
+def _unique(values: list[Any]) -> list[Any]:
+    if len(values) != len(set(values)):
+        raise ValueError("array items must be unique")
+    return values
+
+
+def _true(value: Any) -> bool:
+    if type(value) is not bool or value is not True:
+        raise ValueError("synthetic must be the JSON boolean true")
+    return value
+
+
+def _zero(value: Any) -> int:
+    if type(value) is not int or value != 0:
+        raise ValueError("expected_live_api_calls must be integer zero")
+    return value
+
+
+DateString = Annotated[str, AfterValidator(_date), WithJsonSchema({"type": "string", "format": "date"})]
+UTCString = Annotated[str, AfterValidator(_utc_timestamp), WithJsonSchema({"type": "string", "format": "date-time", "pattern": "Z$"})]
+
+
+class StrictContract(BaseModel):
+    model_config = ConfigDict(strict=True, extra="forbid", allow_inf_nan=False,
+                              revalidate_instances="always")
+'''
+
+CONDITIONALS = {
+'Document': '''    @model_validator(mode="after")
+    def require_verified_file_hash(self) -> Document:
+        if self.asset_status == "file_verified" and self.file_sha256 is None:
+            raise ValueError("file_verified requires file_sha256")
+        return self
+''',
+'Evidence': '''    @model_validator(mode="after")
+    def require_independent_reference(self) -> Evidence:
+        if self.verification_level == "independent_check" and self.independent_check_reference is None:
+            raise ValueError("independent_check requires a reference")
+        return self
+''',
+'DDQuestion': '''    @model_validator(mode="after")
+    def require_duplicate_reference(self) -> DDQuestion:
+        if self.workflow_status == "duplicate" and self.duplicate_of is None:
+            raise ValueError("duplicate workflow requires duplicate_of")
+        return self
+''',
+'AnalystDecision': '''    @model_validator(mode="after")
+    def bind_export_selection(self) -> AnalystDecision:
+        if (self.target_type == "snapshot_export") != (self.selection_digest is not None):
+            raise ValueError("selection_digest is required only for snapshot_export")
+        return self
+''',
+'AnalysisRun': '''    @model_validator(mode="after")
+    def validate_usage_contract(self) -> AnalysisRun:
+        if self.mode == "cached":
+            if any(value != 0 for value in (self.token_input, self.token_output,
+                                           self.reserved_cost_usd, self.actual_cost_usd)):
+                raise ValueError("cached runs have zero tokens and zero cost")
+        if self.mode == "live" and self.status == "completed":
+            if any(value is None for value in (self.model_id, self.pricing_version,
+                                              self.token_input, self.token_output,
+                                              self.finished_at, self.actual_cost_usd)):
+                raise ValueError("completed live runs require model, pricing, usage, time and actual cost")
+        return self
+''',
+}
+
+def annotation(s: dict, owner: str, field: str, inline: list) -> str:
+    if '$ref' in s:
+        return s['$ref'].rsplit('/', 1)[-1]
+    if 'anyOf' in s:
+        return ' | '.join(annotation(v, owner, field, inline) for v in s['anyOf'])
+    if 'oneOf' in s:
+        return 'Annotated[' + ' | '.join(annotation(v, owner, field, inline) for v in s['oneOf']) + ', Field(discriminator="kind")]'
+    if 'const' in s:
+        value = s['const']
+        if value is True:
+            return 'Annotated[Literal[True], BeforeValidator(_true)]'
+        if type(value) is int:
+            return 'Annotated[Literal[0], BeforeValidator(_zero)]'
+        return f'Literal[{value!r}]'
+    if 'enum' in s:
+        return 'Literal[' + ', '.join(repr(v) for v in s['enum']) + ']'
+    t=s['type']
+    if t=='null': return 'None'
+    if t=='object':
+        name = owner + ''.join(v.capitalize() for v in field.split('_'))
+        inline.append((name,s))
+        return name
+    if t=='string' and s.get('format')=='date': return 'DateString'
+    if t=='string' and s.get('format')=='date-time': return 'UTCString'
+    if t=='array':
+        base='list['+annotation(s['items'],owner,field,inline)+']'
+    else:
+        base={'string':'str','integer':'int','number':'int | float','boolean':'bool'}[t]
+    args=[]
+    for key,target in [('minimum','ge'),('maximum','le'),('minLength','min_length'),('maxLength','max_length'),('minItems','min_length'),('maxItems','max_length'),('pattern','pattern')]:
+        if key in s: args.append(f'{target}={s[key]!r}')
+    if s.get('uniqueItems'):args.append('json_schema_extra={"uniqueItems": True}')
+    annotations=[]
+    if args: annotations.append('Field('+', '.join(args)+')')
+    if s.get('uniqueItems'):annotations.append('AfterValidator(_unique)')
+    if t == 'number': annotations.append('WithJsonSchema(' + repr(s) + ')')
+    if annotations:return 'Annotated['+base+', '+', '.join(annotations)+']'
+    return base
+
+
+def generate_class(name,s):
+    inline=[]
+    body=[]
+    for field,prop in s['properties'].items():
+        body.append(f'    {field}: {annotation(prop,name,field,inline)}')
+    pre=''.join(generate_class(n,v) for n,v in inline)
+    result='\n\nclass '+name+'(StrictContract):\n'+'\n'.join(body)+'\n'
+    if s.get('allOf'):
+        result+='\n    model_config = ConfigDict(json_schema_extra='+pprint.pformat({'allOf':s['allOf']},width=100).replace('\n','\n    ')+')\n'
+    if name in CONDITIONALS: result+='\n'+CONDITIONALS[name]
+    return pre+result
+
+code=HEADER
+for name,s in SCHEMA['$defs'].items():
+    if 'properties' in s:code+=generate_class(name,s)
+    else:code+='\n\n'+name+': TypeAlias = '+annotation(s,name,'',[])+'\n'
+entity_names=[name for name,s in SCHEMA['$defs'].items() if 'entity_version' in s.get('properties',{})]
+object_names=[name for name,s in SCHEMA['$defs'].items() if 'properties' in s]
+code+='''
+
+Envelope: TypeAlias = Annotated[DealState | StagedEvidenceUpdate | ExpectedTransition,
+                                Field(discriminator="kind")]
+ENVELOPE_ADAPTER = TypeAdapter(Envelope)
+'''
+code+='\nENTITY_MODELS = {\n'+''.join(f'    {n!r}: {n},\n' for n in entity_names)+'}\n'
+code+='\nMODEL_TYPES = {\n'+''.join(f'    {n!r}: {n},\n' for n in object_names)+'}\n'
+code+='''
+
+def _reject_constant(value: str) -> None:
+    raise ValueError("non-finite JSON numbers are forbidden")
+
+
+def _object_pairs(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
+    result: dict[str, Any] = {}
+    for key, value in pairs:
+        if key in result:
+            raise ValueError("duplicate JSON object keys are forbidden")
+        result[key] = value
+    return result
+
+
+def validate_envelope(data: Any) -> DealState | StagedEvidenceUpdate | ExpectedTransition:
+    """Validate JSON/dict input without coercion, unknown fields or silent keys.
+
+    This validates structure, not cross-record grounding or analyst authority.
+    ExpectedTransition is evaluation-only and must never become model input.
+    """
+    if isinstance(data, (str, bytes, bytearray)):
+        data = json.loads(data, parse_constant=_reject_constant, object_pairs_hook=_object_pairs)
+    return ENVELOPE_ADAPTER.validate_python(data, strict=True)
+
+
+def envelope_json_schema() -> dict[str, Any]:
+    """Return the generated Pydantic schema (descriptive metadata may differ)."""
+    return ENVELOPE_ADAPTER.json_schema()
+'''
+(ROOT/'src/orion/domain/models.py').write_text(code)
+print('Generated',len(object_names),'named structural models and',len(entity_names),'entity models')
