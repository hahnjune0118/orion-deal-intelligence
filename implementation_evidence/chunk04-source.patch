+    footer.text = "SYNTHETIC PRELIMINARY SCREENING  |  "
+    field = OxmlElement("w:fldSimple")
+    field.set(qn("w:instr"), "PAGE")
+    footer._p.append(field)
+    for run in footer.runs:
+        run.font.size = Pt(9)
+    raw = BytesIO()
+    doc.save(raw)
+    return _canonical_ooxml(raw.getvalue())
