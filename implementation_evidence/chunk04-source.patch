+name: Chunk 4 Web Application
+on: [push, pull_request, workflow_dispatch]
+permissions:
+  contents: read
+jobs:
+  browser-and-regression:
+    runs-on: ubuntu-latest
+    env:
+      ORION_MODE: demo
+      ORION_REQUIRE_BROWSER: '1'
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with:
+          python-version: '3.12'
+          cache: pip
+          cache-dependency-path: requirements-linux.lock
+      - run: python -m pip install --require-hashes -r requirements-linux.lock
+      - run: python -m pip install --no-deps --no-build-isolation -e .
+      - run: python -m playwright install --with-deps chromium
+      - run: python scripts/validate_chunk04.py --require-browser
+      - uses: actions/upload-artifact@v4
+        if: always()
+        with:
+          name: chunk04-web-evidence
+          path: |
+            implementation_evidence/chunk04-*.json
+            implementation_evidence/chunk04-pytest.xml
+            implementation_evidence/logs/chunk04-*.log
+            implementation_evidence/screenshots/*.png
