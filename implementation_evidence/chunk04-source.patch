+    monkeypatch.setenv("OPENAI_API_KEY", "dummy-never-send-web-test")
+    result = approve_next(workspace, token, "offline-review")
+    assert result["view"]["revision"] == 2
+    assert "dummy-never-send-web-test" not in json.dumps(result)
+
